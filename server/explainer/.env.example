OPENAI_API_KEY=
PLANNER_MODEL=gpt-5.4-mini
CODEX_MODEL=gpt-5.4
# Default execution is OpenAI-hosted. Docker is an explicit local fallback.
EXPLAINER_WORKER=hosted
HOSTED_AUTHOR_MODEL=gpt-5.4
HOSTED_AUTHOR_REASONING=medium
HOSTED_VALIDATOR_MODEL=gpt-5.4-mini
# Optional absolute path; default .work/hosted-skill.json, created by setup:hosted.
HOSTED_SKILL_CONFIG=
HOST=127.0.0.1
PORT=8787
# Mandatory when binding beyond loopback. Server bootstrap / session creation credential.
BOOTSTRAP_TOKEN=
JOB_TIMEOUT_MS=900000
MAX_CONCURRENT_JOBS=2
SESSION_TTL_MS=3600000
# Optional actual price basis per million tokens; unset reports cost unavailable.
INPUT_USD_PER_MILLION=
CACHED_INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
